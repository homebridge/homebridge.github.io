{
  "compileOnSave": false,
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": false,
    "experimentalDecorators": true,
    "module": "es2020",
    "moduleResolution": "bundler",
    // TypeScript 6 turns strict on when the flag is absent; this codebase
    // predates strict mode, so keep the old behaviour explicit until the
    // planned modernisation pass takes strictness on properly.
    "strict": false,
    "declaration": false,
    "importHelpers": true,
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true
  },
  "angularCompilerOptions": {
    "strictInjectionParameters": true
  }
}
