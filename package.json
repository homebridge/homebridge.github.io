{
  "name": "homebridge.github.io",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration production --output-path dist",
    "lint": "eslint . --max-warnings=0",
    "gen": "tsx scripts/gen.ts && tsx scripts/gen-matter.ts && tsx scripts/sitemap.ts",
    "lint:fix": "npm run lint -- --fix"
  },
  "dependencies": {
    "@angular/animations": "^22.1.0",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "bootstrap": "^5.3.8",
    "marked": "^18.0.9",
    "ngx-bootstrap": "^21.2.1",
    "ngx-markdown": "^22.0.0",
    "prismjs": "^1.30.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^22.1.0",
    "@angular-eslint/eslint-plugin-template": "^22.1.0",
    "@angular-eslint/template-parser": "^22.1.0",
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "@angular/language-service": "^22.1.0",
    "@antfu/eslint-config": "^9.2.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@homebridge/hap-nodejs": "^2.1.9",
    "@prettier/plugin-xml": "^3.4.2",
    "@types/node": "^26.1.2",
    "decamelize": "^6.0.1",
    "eslint-plugin-format": "^2.0.1",
    "homebridge": "^2.2.1",
    "inflection": "^3.0.2",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "uuid": "^14.0.1"
  },
  "allowScripts": {
    "@fortawesome/fontawesome-free": false,
    "@parcel/watcher": true,
    "esbuild": true,
    "fsevents": true,
    "lmdb": true,
    "msgpackr-extract": true,
    "nice-napi": true
  },
  "overrides": {
    "@antfu/eslint-config": {
      "@angular-eslint/eslint-plugin": "^22.1.0",
      "@angular-eslint/eslint-plugin-template": "^22.1.0",
      "@angular-eslint/template-parser": "^22.1.0"
    },
    "ngx-bootstrap": {
      "@angular/common": "^22.1.0",
      "@angular/core": "^22.1.0",
      "@angular/forms": "^22.1.0"
    }
  }
}
